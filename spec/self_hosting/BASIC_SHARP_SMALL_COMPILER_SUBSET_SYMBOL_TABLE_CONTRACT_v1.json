            "line_number": 19
          }
        ],
        "values": [
          {
            "name": "speed",
            "line_number": 15
          }
        ],
        "scene_heads": [
          {
            "starter": "WHEN",
            "head": "PLAYER touches @light switch",
            "line_number": 17
          },
          {
            "starter": "IF",
            "head": "@north door is closed",
            "line_number": 21
          }
        ]
      },
      "expected_symbols_sha256": "49cfae38749d950bf8a29e46170f8aa982221d5a6735a3d446cc7dec8f09ecd2",
      "expected_errors": [],
      "expected_errors_sha256": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945"
    },
    {
      "name": "context_hover_symbols",
      "source": "KINDS\n[\n#thing\n#door is a #thing\n].\nDEFINE\n[\n@north door is a #door\n].\nHOVER for @north door\n[\nname\nkind\nstate\n].\nCONTEXT for @north door\n[\n\"Open\" when @north door is closed (change @north door to open\n].\n",
