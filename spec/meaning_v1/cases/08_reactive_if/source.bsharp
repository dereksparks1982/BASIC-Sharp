KINDS
[
    #guard is a #person
].

DEFINE
[
    @henry is a #guard
    @brass bell is a #device
].

START
[
    @henry is calm
    @brass bell is off
].

WHEN PLAYER attacks @henry
[
    |then (change @henry to angry
].

WHEN PLAYER sounds @brass bell
[
    |then (change @henry to calm
    |then (change @brass bell to off
].

IF @henry is angry
[
    |then (change @brass bell to on
].

IF @brass bell is on
[
    |then (damage PLAYER
].
