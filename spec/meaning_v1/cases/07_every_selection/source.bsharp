KINDS
[
    #guard is a #person
    #captain is a #guard
].

DEFINE
[
    @henry is a #guard
    @mara is a #captain
    @brass bell is a #device
].

START
[
    @henry is calm
    @mara is calm
].

WHEN PLAYER sounds @brass bell
[
    |then (change every #guard to angry
    |then (damage every #guard by 2
].
