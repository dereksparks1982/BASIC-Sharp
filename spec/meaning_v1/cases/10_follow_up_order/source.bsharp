KINDS
[
    #guard is a #person
].

DEFINE
[
    @henry is a #guard
    @mara is a #guard
    @brass bell is a #device
].

WHEN PLAYER attacks @henry
[
    |then (cause @henry attacks PLAYER
    |then (cause @mara sounds @brass bell
].

WHEN @henry attacks PLAYER
[
    |then (damage PLAYER
].

WHEN @mara sounds @brass bell
[
    |then (change @mara to angry
].
