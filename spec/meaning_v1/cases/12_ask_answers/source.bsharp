KINDS
[
    #guard is a #person
    #captain is a #guard
].

DEFINE
[
    @henry is a #guard
    @mara is a #captain
    @brass bell is a #device
].

START
[
    @henry is calm
    @henry has 10 health
    @mara is calm
].

WHEN PLAYER attacks a #guard
[
    |then (damage it by 3
    |then (change it to angry
].

IF @henry has 3 damage
[
    |then (change @mara to angry
].
