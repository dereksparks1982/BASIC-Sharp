KINDS
[
    #guard is a #person
    #captain is a #guard
    #commander is a #captain
].

DEFINE
[
    @general is a #commander
].

WHEN PLAYER attacks a #guard
[
    |then (damage @general
].

WHEN PLAYER attacks a #captain
[
    |then (damage @general by 2
].

WHEN PLAYER attacks a #captain
[
    |then (damage @general by 3
].
