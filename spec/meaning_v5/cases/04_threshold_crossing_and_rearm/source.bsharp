DEFINE
[
    @coin is a #thing
    @toll is a #thing
].
START
[
    PLAYER has 0 score
].
WHEN PLAYER takes @coin
[
    |then (increase score of PLAYER by 10
].
WHEN PLAYER attacks @toll
[
    |then (decrease score of PLAYER by 10
].
IF PLAYER has at least 10 score
[
    |then (change PLAYER to on
].
