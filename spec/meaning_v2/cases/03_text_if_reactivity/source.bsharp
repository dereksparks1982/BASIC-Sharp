DEFINE
[
    @north gate is a #door
    @brass bell is a #device
].

START
[
    @north gate has "closed" label
].

WHEN PLAYER sounds @brass bell
[
    |then (change label of @north gate to "OPEN"
].

WHEN PLAYER speaks @brass bell
[
    |then (change label of @north gate to "closed"
].

IF @north gate has "OPEN" label
[
    |then (damage PLAYER
].
