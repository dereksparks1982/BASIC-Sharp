KINDS
[
    #captain is a #guard
].

DEFINE
[
    @henry is a #guard
    @mara is a #captain
    @brass bell is a #device
].

START
[
    @henry has 10 health
    @mara has 10 health
    @brass bell has 3 charges
    @henry is calm
    @mara is calm
].

WHEN PLAYER sounds @brass bell
[
    |then (damage every #guard by 3
    |then (change health of every #guard to 7
    |then (change charges of @brass bell to 2
].

IF @henry has 3 damage
[
    |then (change @henry to angry
].
