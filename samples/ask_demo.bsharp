KINDS
[
    #captain is a #guard
].

DEFINE
[
    @henry is a #guard
    @mara is a #captain
    @brass bell is a #device
    @brass key is a #key
    @oak table is a #table
].

START
[
    @henry is calm
    @mara is calm
    @brass key is on @oak table
    @henry has 10 health
].

WHEN PLAYER attacks a #guard
[
    |then (damage it by 3
    |then (cause it attacks PLAYER
    |then (change it to angry
].

WHEN a #guard attacks PLAYER
[
    |then (damage PLAYER
].

IF @henry has 3 damage
[
    |then (change @mara to angry
].
