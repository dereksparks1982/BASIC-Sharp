KINDS
[
    #gate is a #door
].

DEFINE
[
    @north gate is a #gate
    @south gate is a #gate
    @brass bell is a #device
].

START
[
    @north gate has "North  Gate!" title
    @south gate has "South Gate." title
].

WHEN PLAYER sounds @brass bell
[
    |then (change title of every #gate to "OPEN — RubyVM!"
].

IF @north gate has "OPEN — RubyVM!" title
[
    |then (damage PLAYER
].
