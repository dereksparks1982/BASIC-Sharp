KINDS
[
    #creature is a #thing
    #dragon is a #creature
    #wyrm is a #dragon
].

DEFINE
[
    @ember is a #wyrm
    @cinder is a #wyrm
    @north door is a #door
    @brass key is a #key
    @oak table is a #table
    @henry is a #guard
].

START
[
    @ember is calm
    @cinder is calm
    @north door is locked
    @brass key is on the #table
    @henry is calm
].

WHEN PLAYER takes @brass key
[
    |then (carry @brass key
].

IF @north door is locked
[
    |then (unlock @north door
].

WHEN PLAYER attacks @ember
[
    |then (damage @ember
    |then (change @ember to angry
].

WHEN PLAYER attacks a #creature
[
    |then (damage it
    |then (change it to angry
].

WHEN PLAYER attacks a #guard
[
    |then (damage it
    |then (change it to angry
].

IF @cinder is angry
[
    |then (damage PLAYER
].
