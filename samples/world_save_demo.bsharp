DEFINE
[
    @henry is a #guard
    @mara is a #guard
    @brass bell is a #device
    @brass key is a #key
    @oak table is a #table
].

START
[
    @henry is calm
    @mara is calm
    @brass key is on @oak table
    @henry has 10 health
].

IF @henry has 3 damage
[
    |then (change @henry to angry
].

WHEN PLAYER attacks @henry
[
    |then (damage @henry by 3
    |then (cause @henry attacks PLAYER
].

WHEN @henry attacks PLAYER
[
    |then (damage PLAYER
    |then (carry @brass key
].
