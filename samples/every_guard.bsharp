KINDS
[
    #captain is a #guard
].

DEFINE
[
    @henry is a #guard
    @mara is a #captain
    @otto is a #guard
    @brass bell is a #device
    @north door is a #door
    @south door is a #door
    @brass key is a #key
    @iron key is a #key
].

START
[
    @henry is calm
    @mara is calm
    @otto is calm
    @north door is locked
    @south door is locked
].

WHEN PLAYER sounds @brass bell
[
    |then (damage every #guard
    |then (change every #guard to angry
    |then (carry every #key
    |then (unlock every #door
].

WHEN PLAYER attacks a #guard
[
    |then (damage every #guard
    |then (change it to hostile
].
